<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3, light + dark from semantic tokens. Edge-to-edge: bars are transparent and every
         screen applies insets itself (ui/Insets.kt). -->
    <style name="Theme.SmartPothole" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sp_primary</item>
        <item name="colorOnPrimary">@color/sp_on_primary</item>
        <item name="colorPrimaryContainer">@color/sp_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/sp_on_primary_container</item>
        <item name="colorSecondary">@color/sp_secondary</item>
        <item name="colorOnSecondary">@color/sp_on_secondary</item>
        <item name="colorSecondaryContainer">@color/sp_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/sp_on_surface</item>
        <item name="colorError">@color/sp_danger</item>
        <item name="android:colorBackground">@color/sp_bg</item>
        <item name="colorSurface">@color/sp_surface</item>
        <item name="colorOnSurface">@color/sp_on_surface</item>
        <item name="colorSurfaceVariant">@color/sp_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/sp_on_surface_muted</item>
        <item name="colorSurfaceContainer">@color/sp_surface</item>
        <item name="colorSurfaceContainerLow">@color/sp_surface</item>
        <item name="colorSurfaceContainerHigh">@color/sp_surface_variant</item>
        <item name="colorOutline">@color/sp_outline</item>
        <item name="colorOutlineVariant">@color/sp_outline</item>
        <item name="android:windowBackground">@color/sp_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="materialCardViewStyle">@style/SP.Card</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
    </style>

    <style name="Theme.SmartPothole.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sp_brand_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SmartPothole</item>
    </style>

    <!-- Full-screen camera/map screens: always dark chrome regardless of system theme. -->
    <style name="Theme.SmartPothole.Immersive" parent="Theme.SmartPothole">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="SP.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/sp_radius_card</item>
        <item name="cardBackgroundColor">@color/sp_surface</item>
        <item name="strokeColor">@color/sp_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="SP.Text.Display" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/sp_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SP.Text.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/sp_on_surface</item>
    </style>
    <style name="SP.Text.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/sp_on_surface</item>
    </style>
    <style name="SP.Text.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/sp_on_surface</item>
    </style>
    <style name="SP.Text.Muted" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/sp_on_surface_muted</item>
    </style>
    <style name="SP.Text.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/sp_on_surface</item>
    </style>
    <style name="SP.Text.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/sp_on_surface_muted</item>
    </style>
    <style name="SP.Text.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/sp_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SP.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/sp_primary_container</item>
    </style>
    <style name="SP.MapFab" parent="Widget.Material3.FloatingActionButton.Small.Surface">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="backgroundTint">@color/sp_surface</item>
        <item name="tint">@color/sp_on_surface</item>
        <item name="fabCustomSize">48dp</item>
    </style>
    <!-- Compact control on dark camera HUDs: icon above label, 64dp tall, high contrast. -->
    <style name="SP.HudButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">2dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">@color/sp_on_hud</item>
        <item name="android:textColor">@color/sp_on_hud</item>
        <item name="backgroundTint">#33FFFFFF</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>
