<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Live road camera" />

    <org.smartpothole.app.camera.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/cameraTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_pill_hud"
                android:contentDescription="Close camera"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/sp_on_hud" />

            <TextView
                android:id="@+id/tvDetectionStatus"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_pill_hud"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:text="Starting camera…"
                android:textColor="@color/sp_on_hud"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGpsAccuracy"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_hud"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="GPS…"
                android:textColor="@color/sp_on_hud"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_my_location"
                app:drawableTint="@color/sp_on_hud" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutSessionPill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_hud"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSessionCodeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session"
                android:textColor="@color/sp_on_hud"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCompanionsCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="0 companions"
                android:textColor="@color/sp_on_hud_muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEndSession"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="End session"
                android:textColor="@color/sp_brand_orange" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutInstantWarningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="assertive"
            android:background="@drawable/bg_card_hud"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warning"
                app:tint="@color/sp_brand_orange" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvInstantWarningTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pothole ahead"
                    android:textColor="@color/sp_on_hud"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInstantWarningSubtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sp_on_hud_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cameraBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/manualConfirmLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_card_hud"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvConfirmPotholeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pothole in view"
                android:textColor="@color/sp_on_hud" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmReport"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Report it" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_hud"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDetectionCounter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 reported"
                    android:textColor="@color/sp_on_hud"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFpsLatency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="–"
                    android:textColor="@color/sp_on_hud_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLastDetectionTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="No detections yet"
                android:textColor="@color/sp_on_hud_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPauseResume"
                    style="@style/SP.HudButton"
                    android:text="Pause"
                    app:icon="@drawable/ic_pause" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeToggle"
                    style="@style/SP.HudButton"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:text="Auto"
                    app:icon="@drawable/ic_check_circle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAudio"
                    style="@style/SP.HudButton"
                    android:text="Voice"
                    app:icon="@drawable/ic_volume_up" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSplit"
                    style="@style/SP.HudButton"
                    android:layout_marginStart="6dp"
                    android:text="Split"
                    app:icon="@drawable/ic_split" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
