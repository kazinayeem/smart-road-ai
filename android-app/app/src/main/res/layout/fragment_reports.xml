<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reportsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/sp_gutter"
        android:paddingVertical="@dimen/sp_space_3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="My reports"
                android:textAppearance="@style/SP.Text.Display" />

            <TextView
                android:id="@+id/tvReportsSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 reports"
                android:textAppearance="@style/SP.Text.Muted" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSync"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Upload now"
            app:icon="@drawable/ic_sync" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReports"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/sp_gutter"
        android:paddingBottom="@dimen/sp_space_4" />

    <LinearLayout
        android:id="@+id/reportsEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/sp_space_6"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_icon_primary"
            android:importantForAccessibility="no"
            android:padding="18dp"
            android:src="@drawable/ic_history"
            app:tint="@color/sp_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_space_4"
            android:text="No reports yet"
            android:textAppearance="@style/SP.Text.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_space_2"
            android:gravity="center"
            android:text="Potholes you detect or mark appear here with their date, time and upload status."
            android:textAppearance="@style/SP.Text.Muted" />
    </LinearLayout>
</LinearLayout>
