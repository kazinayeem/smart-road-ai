<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/companionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/sp_on_surface" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSessionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session"
                android:textAppearance="@style/SP.Text.Subtitle" />

            <TextView
                android:id="@+id/tvScannerStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="Waiting for scanner…"
                android:textAppearance="@style/SP.Text.Caption" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnNotificationSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notification settings"
            android:src="@drawable/ic_notifications"
            app:tint="@color/sp_on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLeaveSession"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Leave"
            android:textColor="@color/sp_danger" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_pill_surface"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvScannerLocationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scanner position unknown"
                android:textAppearance="@style/SP.Text.Label" />

            <TextView
                android:id="@+id/tvScannerAccuracyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/SP.Text.Caption" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabRecenterScanner"
            style="@style/SP.MapFab"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:contentDescription="Show scanner"
            android:src="@drawable/ic_my_location" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/companionSheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:background="@color/sp_surface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/sp_gutter"
        android:paddingTop="@dimen/sp_space_3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvEventsHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="Live detections"
                android:textAppearance="@style/SP.Text.Section" />

            <TextView
                android:id="@+id/tvNewPotholesBadge"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_warning"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="0"
                android:textColor="@color/sp_warning" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEmptyEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_space_3"
            android:text="No detections yet. They appear here the moment the scanner finds one."
            android:textAppearance="@style/SP.Text.Muted" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDetections"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/sp_space_2"
            android:layout_weight="1"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/sp_space_2">

            <TextView
                android:id="@+id/tvScannerNameFooter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/SP.Text.Caption" />

            <TextView
                android:id="@+id/tvCompanionsFooter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/SP.Text.Caption" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
