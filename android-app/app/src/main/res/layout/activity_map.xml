<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- OpenStreetMap Surface -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Modern Glassmorphic HUD Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="14dp"
        android:background="@drawable/pill_badge_bg"
        android:backgroundTint="#EB0F172A"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="#1E293B"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#94A3B8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Road Hazard Map"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMarkerCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Hazards Recorded"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Safe Area Status Badge -->
        <TextView
            android:id="@+id/tvSafeAreaPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_resolved_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="🛡️ Safe Area Clear"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Floating Map Controls (Right Side) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="14dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Recenter on User GPS FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:contentDescription="Locate Me"
            app:backgroundTint="#0284C7"
            app:fabSize="mini"
            app:srcCompat="@android:drawable/ic_menu_mylocation"
            app:tint="#FFFFFF" />

        <!-- Toggle Safe Area Circle FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabToggleSafeArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:contentDescription="Toggle Safe Area Horizon"
            app:backgroundTint="#1E293B"
            app:fabSize="mini"
            app:srcCompat="@android:drawable/ic_menu_compass"
            app:tint="#38BDF8" />

        <!-- Zoom In -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabZoomIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:contentDescription="Zoom In"
            app:backgroundTint="#1E293B"
            app:fabSize="mini"
            app:srcCompat="@android:drawable/btn_plus"
            app:tint="#FFFFFF" />

        <!-- Zoom Out -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabZoomOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Zoom Out"
            app:backgroundTint="#1E293B"
            app:fabSize="mini"
            app:srcCompat="@android:drawable/btn_minus"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Bottom Selected Marker Detail Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/markerDetailCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="14dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:strokeColor="#334155"
        app:strokeWidth="1.5dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvReportId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PTH-001"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReportStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_critical_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="NEW"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnCloseDetail"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="10dp"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#94A3B8" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvReportCoords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="GPS: 23.8069° N, 90.3687° E"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReportConfidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Community Reports: 1 Defect Detection"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReportDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="📍 Distance: 64m Ahead"
                android:textColor="#F59E0B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReportDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Detected: Nov 23, 2026 • 21:40"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvAssignedContractor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Location: Smart Deduplication Cluster"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- OpenStreetMap Attribution Watermark (Mandatory by OSM license) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_margin="6dp"
        android:background="#B00F172A"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="© OpenStreetMap contributors"
        android:textColor="#94A3B8"
        android:textSize="9sp" />

</RelativeLayout>
