<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/sp_space_2"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:padding="@dimen/sp_space_3">

        <ImageView
            android:id="@+id/rowIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_primary"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/ic_warning"
            app:tint="@color/sp_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sp_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rowTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Pothole · 120 m"
                android:textAppearance="@style/SP.Text.Label" />

            <TextView
                android:id="@+id/rowSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="24 Nov 2026, 16:12:05"
                android:textAppearance="@style/SP.Text.Caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/rowChip"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="@dimen/sp_space_2"
            android:background="@drawable/bg_chip_warning"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="High"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
